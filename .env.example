# DisasterShield AI - Environment Variables Template
# NEVER commit production secrets or AWS access keys to frontend code!

# AWS Deployment Configuration
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=123456789012

# Amazon Bedrock AI Models
# Recommended: anthropic.claude-3-haiku-20240307-v1:0 (fast, low cost) or anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# DynamoDB Tables
DYNAMODB_TABLE_INCIDENTS=DisasterShieldIncidents
DYNAMODB_TABLE_SHELTERS=DisasterShieldShelters
DYNAMODB_TABLE_ALERTS=DisasterShieldAlerts

# S3 Bucket for Uploaded Citizen SOS Photo Evidence
S3_BUCKET_NAME=disastershield-media-bucket

# Amazon SNS Emergency Broadcast Topic
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:DisasterShieldEmergencyAlerts

# Frontend API Gateway Integration
# If left empty, DisasterShield automatically runs in LOCAL HIGH-FIDELITY DEMO MODE.
VITE_API_GATEWAY_URL=
VITE_ENABLE_MOCK_DATA=true

# Map Tile Configuration
# Default: OpenStreetMap (Standard tile service with OpenStreetMap contributors attribution)
VITE_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
